# Vantage Environment Configuration Template
# Copy to .env for local overrides (never commit real credentials)

VANTAGE_ENVIRONMENT=development
VANTAGE_DEBUG=true
VANTAGE_HOST=0.0.0.0
VANTAGE_PORT=8000
VANTAGE_LOG_LEVEL=INFO

# AI Providers (Optional — system falls back to statistical/rule synthesis if empty)
VANTAGE_GROQ_API_KEY=
VANTAGE_GEMINI_API_KEY=
VANTAGE_GOOGLE_API_KEY=
VANTAGE_TAVILY_API_KEY=

# Ingestion settings
VANTAGE_INGEST_INTERVAL_MINUTES=60
VANTAGE_MAX_ENTITIES_PER_ADAPTER=50
